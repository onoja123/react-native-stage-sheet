{
  "name": "react-native-stage-sheet",
  "version": "0.1.0",
  "description": "A draggable bottom sheet for React Native & Expo that recedes the parent screen into an iOS-style card stack behind it.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "build": "bob build"
  },
  "keywords": [
    "react-native",
    "expo",
    "bottom-sheet",
    "sheet",
    "modal",
    "card-stack",
    "reanimated",
    "ios",
    "gesture"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godwinokpe/react-native-stage-sheet.git"
  },
  "author": "Okpe Onoja Godwin <gkenny896@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "del-cli": "^5.1.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-builder-bob": "0.23.2",
    "react-native-gesture-handler": "^2.20.0",
    "react-native-reanimated": "^3.16.0",
    "react-native-safe-area-context": "^4.12.0",
    "typescript": "^5.4.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
